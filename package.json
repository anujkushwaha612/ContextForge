{
  "name": "contextforge",
  "version": "1.0.0",
  "description": "Repository-aware execution runtime for AI coding agents. AST-powered compression, graph queries, and verified patching.",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "contextforge": "src/cli/index.js"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "postinstall": "node scripts/postinstall.js",
    "setup:models": "bash scripts/setup-onnx.sh",
    "setup:models:win": "powershell -ExecutionPolicy Bypass -File scripts/setup-onnx.ps1",
    "setup:grammars": "bash scripts/vendor-grammars.sh",
    "setup:all": "npm run setup:grammars && npm run setup:models",
    "build:native": "cd native && node-gyp rebuild",
    "build:native:debug": "cd native && node-gyp rebuild --debug",
    "prebuild": "prebuildify --napi --target 18.0.0 --target 20.0.0 --target 22.0.0 --strip",
    "rebuild": "npm run build:native",
    "docker:build": "docker build -t contextforge:latest .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f contextforge",
    "docker:restart": "docker compose restart contextforge",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --forceExit --testPathPattern=tests/unit",
    "test:smoke": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --forceExit --testPathPattern=tests/smoke",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --forceExit --testPathPattern=tests/integration",
    "test:regression": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --forceExit --testPathPattern=tests/regression",
    "test:workflows": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --forceExit --testPathPattern=tests/workflows",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch --testPathPattern=tests/unit",
    "test:ci": "npm run test:unit && npm run test:smoke",
    "benchmark": "node benchmarks/compression_benchmark.js",
    "lint": "eslint src/ --ext .js",
    "format": "prettier --write 'src/**/*.js' 'tests/**/*.js'",
    "clean": "rm -rf native/build native/tree-sitter-src node_modules models/*.onnx"
  },
  "keywords": [
    "llm",
    "proxy",
    "ai-coding",
    "coding-agent",
    "context-compression",
    "ast",
    "tree-sitter",
    "repository-graph",
    "openai",
    "anthropic",
    "claude",
    "ollama",
    "groq",
    "gemini",
    "aider",
    "cursor",
    "claude-code"
  ],
  "author": {
    "name": "Anuj Kushwaha",
    "url": "https://github.com/anujkushwaha612"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anujkushwaha612/ContextForge.git"
  },
  "bugs": {
    "url": "https://github.com/anujkushwaha612/ContextForge/issues"
  },
  "homepage": "https://github.com/anujkushwaha612/ContextForge#readme",
  "files": [
    "src/",
    "native/",
    "models/",
    "scripts/",
    "prebuilds/",
    "README.md",
    "LICENSE",
    ".env.example",
    "!**/*.test.js",
    "!**/__tests__",
    "!src/data/*.db"
  ],
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "better-sqlite3": "^12.10.0",
    "node-addon-api": "^8.8.0",
    "tiktoken": "^1.0.22"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "node-gyp": "^10.2.0",
    "prebuildify": "^6.0.1",
    "prettier": "^3.3.0"
  },
  "optionalDependencies": {
    "node-gyp-build": "^4.8.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testTimeout": 30000,
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/cli/**",
      "!src/data/**"
    ]
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100,
    "arrowParens": "always"
  }
}
