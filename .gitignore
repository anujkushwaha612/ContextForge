# ─────────────────────────────────────────────
# Environment & secrets
# ─────────────────────────────────────────────
.env
.env.*
!.env.example


# ─────────────────────────────────────────────
# Dependencies
# ─────────────────────────────────────────────
node_modules/

# ─────────────────────────────────────────────
# Native build output (regenerated by node-gyp / CI)
# ─────────────────────────────────────────────
native/build/
build/
prebuilds/
*.node

# Vendored third-party code:
#   COMMITTED: nlohmann (CI needs it), sqlite3 (binding.gyp compiles it on all platforms)
#   IGNORED:   onnxruntime (platform-specific, ~300MB with .pdb — CI downloads its own)
native/vendor/onnxruntime/

# tree-sitter grammars — regenerated by scripts/vendor-grammars.sh
native/tree-sitter-src/

# ─────────────────────────────────────────────
# Runtime state (never commit user/session data)
# ─────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
data/
CF-savings/
debug_translation/
debug_payload.json

# ML models — downloaded by cf setup / scripts/setup-onnx.sh
contextforge_models/

# ContextForge home dir if ever created repo-locally (CF_HOME override)
.contextforge/

# ─────────────────────────────────────────────
# Tools & agents
# ─────────────────────────────────────────────
.claude/
.devcontainer/

# ─────────────────────────────────────────────
# OS / IDE
# ─────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ─────────────────────────────────────────────
# Logs & scratch
# ─────────────────────────────────────────────
*.log
logs/
__pycache__/
test-*


# benchmarks_old/
# benchmarks/fixtures/repositories/
# benchmarks/fixtures/payloads/
# benchmarks/fixtures/prompts/
# benchmarks/fixtures/sessions/
# benchmarks/results/
tests/
benchmarks/


